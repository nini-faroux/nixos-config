// Waybar config
{
    "layer": "top", // Waybar at top layer
    "position": "bottom", // Bottom of screen
    "height": 48, // Waybar height (to be removed for auto height)
    "spacing": 6, // Gaps between modules (4px)

    // Modules order
    "modules-left": [
      "custom/apps",
      "sway/workspaces",
      "sway/window"
    ],
    "modules-center": [
    ],
    "modules-right": [
      "cpu",
      "memory",
      "network",
      "custom/volume",
      "battery",
      "clock"
    ],

    // Modules config
    "clock": {
      "timezone": "Europe/Dublin",
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": { 
      "interval": 10, 
      "format": "CPU: {usage}%" 
    },
    "memory": {
      "interval": 30,
      "format": 
        "RAM: {used:0.1f}GiB/{total:0.1f}GiB ({percentage}%) SWAP: {swapUsed:0.1f}GiB/{swapTotal:0.1f}GiB ({swapPercentage}%)"
    },
    "battery": {
      "states": {
          "warning": 30,
          "critical": 15
      },
      "format": "{capacity}% {icon}",
      "format-full": "{capacity}% {icon}",
      "format-charging": "{capacity}% ",
      "format-plugged": "{capacity}% ",
      "format-alt": "{time} {icon}",
      "format-icons": ["", "", "", "", ""]
    },
    "network": {
      "format-wifi": "{essid} ",
      "format-ethernet": "{ipaddr}/{cidr} ",
      "tooltip-format": "{ifname} via {gwaddr} ",
      "format-linked": "{ifname} (No IP) ",
      "format-disconnected": "Disconnected ⚠",
      "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    // One liner is a bit messy but doesn't allow multi-line it seems
    "custom/volume": {
        "exec": "volume=$(pamixer --get-volume); muted=$(pamixer --get-mute); if [ \"$muted\" = true ]; then echo \"0% 🔇\"; elif [ $volume -ge 70 ]; then echo \"$volume% 🔊\"; elif [ $volume -ge 30 ]; then echo \"$volume% 🔉\"; else echo \"$volume% 🔈\"; fi",
      "interval": 1,
      "on-click": "pavucontrol",
      "format": "{}"
    }
}
